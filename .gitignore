# ======================================
# PYTHON ENVIRONMENTS
# ======================================

.venv/
venv/
env/
ENV/

# ======================================
# SECRETS / AUTHENTICATION
# ======================================

# Environment variables
.env
.env.*
!.env.example

# NASA Earthdata / authentication
.netrc
cookies.txt
*.token
*.secret
.earthaccess*
earthdata_credentials*

# Copernicus / ERA5 CDS credentials
.cdsapirc
cds_credentials*

# Generic credentials
credentials.json
secrets.json
*.pem
*.key

auth/
credentials/
tokens/

# ======================================
# PYTHON CACHE / TEST CACHE
# ======================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
.coverage.*
htmlcov/

